+    def check_initial_refs(self, x, n):
+        """Point references past the level's initials at no object (-1) instead.
+
+        Ares read whatever followed the initials table; Antares indexes out of bounds.
+        """
+        if isinstance(x, list):
+            for v in x:
+                self.check_initial_refs(v, n)
+            return
+        if not isinstance(x, dict):
+            return
+        for k, v in x.items():
+            if k == 'initial' and isinstance(v, list):
+                ok = [i for i in v if 0 <= i < n]
+                if len(ok) != len(v):
+                    self.warn('initial references %s past %d initials; dropped'
+                              % ([i for i in v if not 0 <= i < n], n))
+                    x[k] = ok
+            elif k == 'initial' and isinstance(v, int) and v >= n:
+                self.warn('initial reference %d past %d initials; set to none' % (v, n))
+                x[k] = -1
+            else:
+                self.check_initial_refs(v, n)
+
