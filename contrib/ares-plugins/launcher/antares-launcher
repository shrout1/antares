FACTORY_ID = '4cab7415715aeeacf1486a352267ae82c0efb220'  # kFactoryScenarioIdentifier


def find_antares():
    if WINDOWS:
        # A build in this checkout (out/win/opt, made by configure and ninja) if not on PATH.
        return shutil.which('antares') or os.path.join(REPO, 'out', 'win', 'opt', 'antares.exe')
    if MAC:
        # The app in Applications, or a build in this checkout.
        bundles = [os.path.join(d, 'Antares.app') for d in
                   ('/Applications', os.path.join(HOME, 'Applications'))]
        bundles.append(os.path.join(REPO, 'out', 'mac', 'opt', 'Antares.app'))
        exes = [os.path.join(b, 'Contents', 'MacOS', 'Antares') for b in bundles]
        return next((e for e in exes if os.path.exists(e)), exes[0])
    return shutil.which('antares') or '/usr/local/games/antares'


def app_data():
    """The folder holding the original game's info.pn and levels."""
    if MAC:
        # Unpacked from the original game on first launch.
        return os.path.join(GAME_DATA, 'Scenarios', FACTORY_ID)
    if not WINDOWS:
        return '/usr/local/share/games/antares/app'
    # Antares.exe looks for data beside itself; a build in this checkout uses the data submodule.
    beside = os.path.join(os.path.dirname(find_antares()), 'data')
    return beside if os.path.isdir(beside) else os.path.join(REPO, 'data')


# GNOME schemas whose shortcuts can take Windows-key and Alt combinations away from the game.
SHORTCUT_SCHEMAS = [
    'org.gnome.desktop.wm.keybindings',
    'org.gnome.mutter.keybindings',
    'org.gnome.mutter.wayland.keybindings',
    'org.gnome.shell.keybindings',
    'org.gnome.settings-daemon.plugins.media-keys',
    'org.gnome.shell.extensions.tiling-assistant',
    'org.gnome.shell.extensions.dash-to-dock',
]


def gsettings(*args):
    try:
        out = subprocess.run(['gsettings', *args], check=True, capture_output=True, text=True,
                             timeout=10)
        return out.stdout
    except (OSError, subprocess.SubprocessError):
        return None


def game_key_shortcuts():
    """Desktop shortcuts that use the Windows key or Alt, as {"schema key": value}.

    The game uses both as fire keys, so these combine with its other keys. Values are in
    gsettings syntax, ready to restore.
    """
    found = {}
    overlay = (gsettings('get', 'org.gnome.mutter', 'overlay-key') or '').strip()
    if overlay and overlay != "''":
        found['org.gnome.mutter overlay-key'] = overlay
    for schema in SHORTCUT_SCHEMAS:
        for line in (gsettings('list-recursively', schema) or '').splitlines():
            parts = line.split(' ', 2)
            if len(parts) < 3 or not parts[2].lstrip('@as ').startswith('['):
                continue
            if re.search(r'<(Super|Alt|Mod4|Meta)>', parts[2], re.I):
                found[parts[0] + ' ' + parts[1]] = parts[2]
    return found


def free_game_keys(shortcuts):
    for name, value in shortcuts.items():
        schema, key = name.split(' ')
        if key == 'overlay-key':
            gsettings('set', schema, key, '')
            continue
        accels = ast.literal_eval(value.replace('@as ', '', 1))
        kept = [a for a in accels if not re.search(r'<(Super|Alt|Mod4|Meta)>', a, re.I)]
        gsettings('set', schema, key, repr(kept))


def restore_shortcuts(shortcuts):
    for name, value in shortcuts.items():
        schema, key = name.split(' ')
        gsettings('set', schema, key, value)


def supports_plugins_option(exe):
    # Builds with the in-game Plugins screen accept -p to list another plugin folder.
    try:
        out = subprocess.run([exe, '--help'], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return False
    return '--plugins' in (out.stdout + out.stderr)


def field(info, name):
    m = re.search(r'^%s:\s*"(.*)"' % name, info, re.M)
    return re.sub(r'\\(.)', r'\1', m.group(1)) if m else ''  # Procyon escapes \" and \\


def read_plugin(path):
    """Title, author, version, identifier, description, solo chapters and net level count of a
    plugin."""
    description = ''
    if path == FACTORY:
        info = open(os.path.join(app_data(), 'info.pn'), encoding='utf-8').read()
        levels = []
        ldir = os.path.join(app_data(), 'levels')
        for f in sorted(os.listdir(ldir)):
            levels.append(open(os.path.join(ldir, f), encoding='utf-8').read())
    else:
        with zipfile.ZipFile(path) as z:
            info = z.read('info.pn').decode('utf-8')
            levels = [z.read(n).decode('utf-8') for n in z.namelist()
                      if n.startswith('levels/') and n.endswith('.pn')]
            if 'description.txt' in z.namelist():  # the Ares Addons archive's description
                description = z.read('description.txt').decode('utf-8', 'replace').strip()
    chapters, net = [], 0
    for text in levels:
        m = re.search(r'^chapter:\s*(\d+)', text, re.M)
        if m:
            chapters.append(int(m.group(1)))
        elif re.search(r'^type:\s*"net"', text, re.M):
            net += 1
    title = field(info, 'title') or os.path.basename(path)
    ident = field(info, 'identifier') or hashlib.sha1(title.encode('utf-8')).hexdigest()
    return {'path': path, 'title': title, 'author': field(info, 'author'),
            'version': field(info, 'version'), 'id': ident, 'description': description,
            'chapters': sorted(chapters), 'net': net}


def unlocked(ident):
    """Unlocked chapters from Antares's ledger, plus when it was last written."""
    p = os.path.join(REGISTRY, ident + '.pn')
    try:
        text = open(p, encoding='utf-8').read()
        m = re.search(r'chapters:\s*\[([^\]]*)\]', text)
        chs = sorted(int(x) for x in re.findall(r'\d+', m.group(1))) if m else [1]
        return chs, os.path.getmtime(p)
    except OSError:
        return [1], None


def read_chapters(path):
    text = open(path, encoding='utf-8').read()
    m = re.search(r'chapters:\s*\[([^\]]*)\]', text)
    if not m:
        raise ValueError(path)
    ident = re.search(r'identifier:\s*"([^"]*)"', text)
    return sorted(int(x) for x in re.findall(r'\d+', m.group(1))), ident and ident.group(1)


def write_chapters(path, chapters, title=None, ident=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    text = 'unlocked:\n\tchapters:  [%s]\n' % ', '.join(str(c) for c in chapters)
    if ident:
        text += 'plugin:\n\ttitle:       %s\n\tidentifier:  "%s"\n' % (
            json.dumps(title, ensure_ascii=False), ident)
    with open(path, 'w', encoding='utf-8') as f:
        f.write(text)


class Launcher(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title('Antares Launcher')
        self.geometry('980x720')
        self.minsize(720, 420)
        ttk.Style(self).theme_use('clam')
        self.cfg = self.load_config()
        self.plugins = []
        self.proc = None
        self.protocol('WM_DELETE_WINDOW', self.close)

        top = ttk.Frame(self, padding=(10, 10, 10, 4))
        top.pack(fill='x')
        ttk.Label(top, text='Search:').pack(side='left')
        self.query = tk.StringVar()
        self.query.trace_add('write', lambda *a: self.fill())
        e = ttk.Entry(top, textvariable=self.query, width=30)
        e.pack(side='left', padx=(4, 12))
        e.focus_set()
        ttk.Button(top, text='Plugins folder…', command=self.choose_folder).pack(side='left')
        self.folder_label = ttk.Label(top, foreground='#666')
        self.folder_label.pack(side='left', padx=8)

        body = ttk.PanedWindow(self, orient='horizontal')
        body.pack(fill='both', expand=True, padx=10)
        left = ttk.Frame(body)
        cols = ('author', 'chapters', 'progress')
        self.tree = ttk.Treeview(left, columns=cols, selectmode='browse')
        self.tree.heading('#0', text='Scenario', command=lambda: self.sort('title'))
        self.tree.heading('author', text='Author', command=lambda: self.sort('author'))
        self.tree.heading('chapters', text='Chapters', command=lambda: self.sort('chapters'))
        self.tree.heading('progress', text='Progress', command=lambda: self.sort('progress'))
        self.tree.column('#0', width=300)
        self.tree.column('author', width=170)
        self.tree.column('chapters', width=80, anchor='center')
        self.tree.column('progress', width=90, anchor='center')
        sb = ttk.Scrollbar(left, orient='vertical', command=self.tree.yview)
        self.tree.configure(yscrollcommand=sb.set)
        self.tree.pack(side='left', fill='both', expand=True)
        sb.pack(side='left', fill='y')
        self.tree.bind('<<TreeviewSelect>>', lambda e: self.show_details())
        self.tree.bind('<Double-1>', lambda e: self.launch())
        self.tree.bind('<Return>', lambda e: self.launch())
        body.add(left, weight=3)

        right = ttk.Frame(body, padding=(12, 0, 0, 0))
        text = dict(wrap='word', width=34, relief='flat', background=self.cget('background'),
                    font=('TkDefaultFont', 10))
        progress = ttk.Frame(right, padding=(0, 6, 0, 0))
        progress.pack(fill='x', side='bottom')
        # Sized to fit by fit_details(); the description below takes the rest of the pane.
        self.details = tk.Text(right, height=10, **text)
        self.details.configure(state='disabled')
        self.details.pack(fill='x')
        self.details.bind('<Configure>', lambda e: self.fit_details())
        desc = ttk.Frame(right)
        desc.pack(fill='both', expand=True)
        self.description = tk.Text(desc, height=4, **text)
        dsb = ttk.Scrollbar(desc, orient='vertical', command=self.description.yview)
        self.description.configure(yscrollcommand=dsb.set, state='disabled')
        dsb.pack(side='right', fill='y')
        self.description.pack(fill='both', expand=True)
        ttk.Label(progress, text='Progress:').pack(side='left', padx=(0, 6))
        self.save_btn = ttk.Button(progress, text='Save', width=7, command=self.save_progress)
        self.import_btn = ttk.Button(progress, text='Import', width=7, command=self.import_progress)
        self.reset_btn = ttk.Button(progress, text='Reset', width=7, command=self.reset_progress)
        for b in (self.save_btn, self.import_btn, self.reset_btn):
            b.pack(side='left', padx=(0, 6))
        body.add(right, weight=2)

        bottom = ttk.Frame(self, padding=10)
        bottom.pack(fill='x', side='bottom', before=body)
        # Both options are for Linux: Mesa's software renderer and GNOME's shortcuts.
        linux = not (WINDOWS or MAC)
        self.software = tk.BooleanVar(value=self.cfg.get('software', True) and linux)
        self.free_super = tk.BooleanVar(value=self.cfg.get('free_super', True) and linux)
        if linux:
            ttk.Checkbutton(bottom, text='Software rendering',
                            variable=self.software, command=self.save_config).pack(side='left')
            ttk.Checkbutton(bottom, text='Let the game use the Windows and Alt keys',
                            variable=self.free_super, command=self.save_config).pack(
                                side='left', padx=(12, 0))
        self.status = ttk.Label(bottom, foreground='#666')
        self.status.pack(side='left', padx=12)
        self.launch_btn = ttk.Button(bottom, text='Launch', command=self.launch)
        self.launch_btn.pack(side='right')

        self.sort_key = self.cfg.get('sort', 'title')
        self.load_plugins()
        self.restore_shortcuts()  # in case the launcher was killed during a game
        self.bind('<FocusIn>', lambda e: self.refresh_progress())

    # ---- settings
    def load_config(self):
        try:
            return json.load(open(CONFIG))
        except (OSError, ValueError):
            return {}

    def save_config(self):
        self.cfg['free_super'] = self.free_super.get()
        self.cfg['software'] = self.software.get()
        self.cfg['sort'] = self.sort_key
        try:
            os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
            json.dump(self.cfg, open(CONFIG, 'w'), indent=2)
        except OSError:
            pass

    def folder(self):
        return self.cfg.get('folder', DEFAULT_FOLDER)

    def choose_folder(self):
        d = filedialog.askdirectory(initialdir=self.folder(), title='Folder of .antaresplugin files')
        if d:
            self.cfg['folder'] = d
            self.save_config()
            self.load_plugins()

    # ---- list
    def load_plugins(self):
        self.folder_label.configure(text=self.folder())
        self.plugins = [read_plugin(FACTORY)]
        self.plugins[0]['title'] = 'Ares (original game)'
        bad = 0
        names = []
        for dp, dn, fn in os.walk(self.folder()):
            dn.sort()
            names += [os.path.relpath(os.path.join(dp, f), self.folder())
                      for f in sorted(fn) if f.endswith('.antaresplugin')]
        for n in names:
            try:
                p = read_plugin(os.path.join(self.folder(), n))
            except Exception:
                bad += 1
                continue
            p['file'] = n
            m = re.search(r' \((.+)\)\.antaresplugin$', n)
            if m:  # another plugin has the same title; show which file this is
                p['title'] += '  (%s)' % m.group(1)
            if n.split(os.sep)[0] == 'Official':
                p['title'] += '  [official]'
            self.plugins.append(p)
        self.refresh_progress(fill=False)
        self.fill()
        self.status.configure(text='%d plugins%s' % (len(self.plugins) - 1,
                                                    ', %d unreadable' % bad if bad else ''))

    def refresh_progress(self, fill=True):
        for p in self.plugins:
            chs, mtime = unlocked(p['id'])
            p['unlocked'] = [c for c in chs if c in p['chapters']]
            if not p['unlocked'] and p['chapters']:
                p['unlocked'] = p['chapters'][:1]  # Antares opens the first chapter if 1 is missing
            p['last'] = mtime
        if fill:
            self.fill(keep=True)

    def progress_text(self, p):
        if not p['chapters']:
            return 'net only'
        return '%d / %d' % (len(p['unlocked']), len(p['chapters']))

    def sort(self, key):
        self.sort_key = key
        self.save_config()
        self.fill(keep=True)

    def fill(self, keep=False):
        sel = self.tree.selection()
        want = sel[0] if (keep and sel) else self.cfg.get('last')
        self.tree.delete(*self.tree.get_children())
        q = self.query.get().lower().strip()
        factory, rest = self.plugins[:1], self.plugins[1:]
        keys = {'title': lambda p: p['title'].lower(),
                'author': lambda p: p['author'].lower(),
                'chapters': lambda p: -len(p['chapters']),
                'progress': lambda p: -(p['last'] or 0)}
        rest = sorted(rest, key=keys.get(self.sort_key, keys['title']))
        for p in factory + rest:
            hay = (p['title'] + ' ' + p['author'] + ' ' + p.get('file', '')).lower()
            if q and q not in hay:
                continue
            iid = p['path'] or '<factory>'
            self.tree.insert('', 'end', iid=iid, text=p['title'],
                             values=(p['author'], len(p['chapters']) or '–', self.progress_text(p)))
        kids = self.tree.get_children()
        if kids:
            target = want if want in kids else kids[0]
            self.tree.selection_set(target)
            self.tree.see(target)

    def selected(self):
        sel = self.tree.selection()
        if not sel:
            return None
        path = '' if sel[0] == '<factory>' else sel[0]
        return next((p for p in self.plugins if p['path'] == path), None)

    def show_details(self):
        p = self.selected()
        t = self.details
        t.configure(state='normal')
        t.delete('1.0', 'end')
        if p:
            lines = [p['title'], '']
            if p['author']:
                lines.append('Author:   ' + p['author'])
            if p['version']:
                lines.append('Version:  ' + p['version'])
            lines.append('File:     ' + (p.get('file') or 'built-in'))
            if p.get('file', '').split(os.sep)[0] == 'Official':
                lines.append('Source:   arescentral.org hand-made conversion '
                             '(progress shared with the converted version)')
            lines.append('')
            if p['chapters']:
                lines.append('Solo chapters: %d' % len(p['chapters']))
                lines.append('Unlocked: ' + ', '.join(str(c) for c in p['unlocked']))
                nxt = [c for c in p['chapters'] if c not in p['unlocked']]
                if nxt:
                    lines.append('Next locked: chapter %d' % nxt[0])
                else:
                    lines.append('All chapters unlocked.')
            if p['net']:
                lines.append('Net levels: %d (multiplayer)' % p['net'])
            if not p['chapters']:
                lines.append('')
                lines.append("Network-only: Antares doesn't support network play yet, so "
                             "there is nothing to play solo in this one.")
            lines.append('')
            lines.append('Last progress: ' + (time.strftime('%Y-%m-%d %H:%M', time.localtime(p['last']))
                                              if p['last'] else 'never'))
            lines.append('Progress file: registry/%s.pn' % p['id'][:12] + '…')
            t.insert('1.0', '\n'.join(lines))
            t.tag_add('title', '1.0', '1.end')
            t.tag_configure('title', font=('TkDefaultFont', 13, 'bold'))
        t.configure(state='disabled')
        self.fit_details()

        d = self.description
        d.configure(state='normal')
        d.delete('1.0', 'end')
        if p and p['description']:
            d.insert('1.0', 'Description\n', 'heading')
            d.insert('end', p['description'])
            d.tag_configure('heading', font=('TkDefaultFont', 10, 'bold'))
        d.configure(state='disabled')
        self.update_progress_buttons()

    def fit_details(self):
        """Makes the details as tall as their wrapped text, so none of it is hidden."""
        t = self.details
        pixels = t.count('1.0', 'end', 'ypixels')
        pixels = pixels[0] if isinstance(pixels, tuple) else pixels
        line = tkfont.Font(font=t.cget('font')).metrics('linespace')
        height = max(1, math.ceil((pixels or 0) / line))
        if int(t.cget('height')) != height:
            t.configure(height=height)

    # ---- progress
    def update_progress_buttons(self):
        p = self.selected()
        # The game writes the registry while it runs, so leave progress alone until it exits.
        ok = bool(p and p['chapters']) and not (self.proc and self.proc.poll() is None)
        self.save_btn.configure(state='normal' if ok else 'disabled')
        self.reset_btn.configure(state='normal' if ok else 'disabled')
        self.import_btn.configure(state='normal' if ok else 'disabled')

    def progress_changed(self):
        self.refresh_progress()
        self.show_details()

    def progress_folder(self):
        """Where the file browser opens: the folder last used, or saved-progress/ at first."""
        d = self.cfg.get('progress_folder', SAVED)
        if d == SAVED:
            os.makedirs(SAVED, exist_ok=True)
        return d if os.path.isdir(d) else HOME

    def save_progress(self):
        p = self.selected()
        name = re.sub(r'[<>:"/\\|?*]', '_', p['title']).strip() or p['id']
        path = filedialog.asksaveasfilename(
            parent=self, title='Save Progress for ' + p['title'], initialdir=self.progress_folder(),
            initialfile=name + '.pn', defaultextension='.pn',
            filetypes=[('Antares progress', '*.pn'), ('All files', '*.*')])
        if not path:
            return
        try:
            chs = read_chapters(os.path.join(REGISTRY, p['id'] + '.pn'))[0]
        except (OSError, ValueError):
            chs = [1]
        try:
            write_chapters(path, chs, p['title'], p['id'])
        except OSError as e:
            messagebox.showerror('Save Progress', 'Couldn\'t save to %s:\n%s' % (path, e))
            return
        self.cfg['progress_folder'] = os.path.dirname(path)
        self.save_config()
        self.status.configure(text='Saved progress for %s to %s' % (p['title'], path))
        self.progress_changed()

    def import_progress(self):
        p = self.selected()
        path = filedialog.askopenfilename(
            parent=self, title='Import Progress into ' + p['title'],
            initialdir=self.progress_folder(),
            filetypes=[('Antares progress', '*.pn'), ('All files', '*.*')])
        if not path:
            return
        try:
            chs, ident = read_chapters(path)
        except (OSError, ValueError, UnicodeDecodeError):
            messagebox.showerror('Import Progress', '%s isn\'t a progress file.' % path)
            return
        self.cfg['progress_folder'] = os.path.dirname(path)
        self.save_config()
        if ident and ident != p['id']:
            other = next((q['title'] for q in self.plugins if q['id'] == ident), 'another plugin')
            if not messagebox.askyesno(
                    'Import Progress', 'This file is progress for %s. Import it into %s anyway?'
                    % (other, p['title'])):
                return
        if not messagebox.askyesno(
                'Import Progress', 'Replace your progress in %s (chapters %s) with chapters %s?' % (
                    p['title'], ', '.join(str(c) for c in p['unlocked']) or 'none',
                    ', '.join(str(c) for c in chs) or 'none')):
            return
        write_chapters(os.path.join(REGISTRY, p['id'] + '.pn'), chs)
        self.status.configure(text='Imported progress for ' + p['title'])
        self.progress_changed()

    def reset_progress(self):
        p = self.selected()
        if not messagebox.askyesno(
                'Reset Progress', 'Forget your progress in %s? Any saved copy is kept.' % p['title']):
            return
        try:
            os.remove(os.path.join(REGISTRY, p['id'] + '.pn'))
        except FileNotFoundError:
            pass
        self.status.configure(text='Reset progress for ' + p['title'])
        self.progress_changed()

    # ---- launch
    def launch(self, p=None):
        p = p or self.selected()
        if not p:
            return
        if self.proc and self.proc.poll() is None:
            messagebox.showinfo('Antares Launcher', 'Antares is already running.')
            return
        exe = find_antares()
        if not os.path.exists(exe):
            messagebox.showerror('Antares Launcher', 'Antares not found at %s' % exe)
            return
        env = dict(os.environ)
        if os.path.exists(ALSOFT_CONF):
            env['ALSOFT_CONF'] = ALSOFT_CONF
        os.makedirs(INPUT_LOGS, exist_ok=True)
        old = sorted(f for f in os.listdir(INPUT_LOGS) if f.endswith('.log'))
        for f in old[:max(0, len(old) - KEEP_INPUT_LOGS + 1)]:
            os.remove(os.path.join(INPUT_LOGS, f))
        env['ANTARES_INPUT_LOG'] = os.path.join(INPUT_LOGS, time.strftime('%Y%m%d-%H%M%S.log'))
        if self.software.get():
            env['LIBGL_ALWAYS_SOFTWARE'] = '1'
        else:
            env.pop('LIBGL_ALWAYS_SOFTWARE', None)
        cmd = [exe]
        if WINDOWS and app_data() != os.path.join(os.path.dirname(exe), 'data'):
            cmd += ['-a', app_data()]
        if not MAC and supports_plugins_option(exe):  # the Mac app would open, not print help
            cmd += ['-p', self.folder()]
        cmd += [p['path']] if p['path'] else []
        if self.free_super.get():
            shortcuts = game_key_shortcuts()
            if shortcuts:
                # Saved first, so a later launcher can restore them if this one is killed.
                self.cfg['saved_shortcuts'] = shortcuts
                self.save_config()
                free_game_keys(shortcuts)
        self.cfg['last'] = p['path'] or '<factory>'
        self.save_config()
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        self.log = open(LOG, 'w')  # a file, not a pipe: a chatty game can't fill it and stall
        self.proc = subprocess.Popen(cmd, env=env, start_new_session=True,
                                     stdout=self.log, stderr=subprocess.STDOUT)
        self.status.configure(text='Running: ' + p['title'])
        self.launch_btn.configure(state='disabled')
        self.update_progress_buttons()
        self.after(1000, self.watch)

    def restore_shortcuts(self):
        saved = self.cfg.pop('saved_shortcuts', None)
        old = self.cfg.pop('saved_overlay_key', None)
        if old:
            gsettings('set', 'org.gnome.mutter', 'overlay-key', old)
        if saved:
            restore_shortcuts(saved)
        if saved or old:
            self.save_config()

    def close(self):
        # A game still running loses the keys now, rather than the desktop keeping them off.
        self.restore_shortcuts()
        self.destroy()

    def watch(self):
        if self.proc.poll() is None:
            self.after(1000, self.watch)
            return
        self.log.close()
        self.restore_shortcuts()
        try:
            err = open(LOG, encoding='utf-8', errors='replace').read().strip()
        except OSError:
            err = ''
        self.launch_btn.configure(state='normal')
        self.update_progress_buttons()
        self.status.configure(text='%d plugins' % (len(self.plugins) - 1))
        self.refresh_progress()
        if self.proc.returncode not in (0, None) and err:
            messagebox.showerror('Antares exited with an error', err[-2000:])


if __name__ == '__main__':
    Launcher().mainloop()
