# contrib/ares-plugins, followed through a symlink so an installed link still finds it.
CONTRIB = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
REPO = os.path.dirname(os.path.dirname(CONTRIB))


def documents():
    """The Documents folder, where Antares keeps its data on Windows (it may be moved)."""
    import ctypes
    buf = ctypes.create_unicode_buffer(260)
    if ctypes.windll.shell32.SHGetFolderPathW(None, 5, None, 0, buf) == 0:  # CSIDL_PERSONAL
        return buf.value
    return os.path.join(HOME, 'Documents')


