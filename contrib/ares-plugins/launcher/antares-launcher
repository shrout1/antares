    CONFIG_DIR = os.path.join(os.environ.get('APPDATA', HOME), 'Antares Launcher')
    CACHE_DIR = os.path.join(os.environ.get('LOCALAPPDATA', HOME), 'Antares Launcher')
    CONFIG = os.path.join(CONFIG_DIR, 'antares-launcher.json')
    GAME_DATA = os.path.join(documents(), 'Antares')  # dirs().root in src/config/win-dirs.cpp
    REGISTRY = os.path.join(GAME_DATA, 'Registry')
elif MAC:
    LIBRARY = os.path.join(HOME, 'Library')
