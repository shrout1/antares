    CONFIG = os.path.join(CONFIG_DIR, 'antares-launcher.json')
    GAME_DATA = os.path.join(LIBRARY, 'Application Support', 'Antares')  # mac-dirs.cpp
    REGISTRY = os.path.join(GAME_DATA, 'Registry')
else:
    CONFIG_DIR = os.path.join(HOME, '.config', 'antares-launcher')
    CACHE_DIR = os.path.join(HOME, '.cache')
    CONFIG = os.path.join(HOME, '.config', 'antares-launcher.json')
    GAME_DATA = os.path.join(HOME, '.local', 'share', 'games', 'antares')  # linux-dirs.cpp
    REGISTRY = os.path.join(GAME_DATA, 'registry')
LOG = os.path.join(CACHE_DIR, 'antares-launcher.log')
INPUT_LOGS = os.path.join(CACHE_DIR, 'antares-input')  # one per game; builds with input-debug
