declare_args() {
  add_cflags = []
  add_cflags_c = []
  add_cflags_cc = []
  add_ldflags = []
}

config("add_flags") {
  cflags = add_cflags
  cflags_c = add_cflags_c
  cflags_cc = add_cflags_cc
  ldflags = add_ldflags
}

# The msvc toolchain reads header dependencies from cl.exe's /showIncludes output; without it,
# ninja doesn't rebuild objects when a header they include changes.
config("msvc-deps") {
  cflags = [ "/showIncludes" ]
}

config("mac-universal") {
  cflags = [
    "-arch",
    "x86_64",
    "-arch",
    "arm64",
  ]
  ldflags = [
    "-arch",
    "x86_64",
    "-arch",
    "arm64",
  ]
}
